# Copy to .env and fill in. Never commit real values.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
TELEGRAM_ALLOWED_USER_IDS=
# Requests per minute per Telegram user (0 = no limit)
TELEGRAM_RATE_LIMIT_PER_MINUTE=10

# --- Web API ---
# Shared access key; the web UI asks for it once and sends it as X-API-Key (empty = open API)
WEB_API_KEY=
# Requests per minute per client IP for /api/* POST endpoints (0 = no limit)
WEB_RATE_LIMIT_PER_MINUTE=20
WEB_MAX_UPLOAD_MB=12
# Comma-separated origins allowed for cross-origin calls (empty = same-origin only)
WEB_CORS_ORIGINS=
# Proxies trusted to set X-Forwarded-For (needed behind Railway for per-IP limits)
FORWARDED_ALLOW_IPS=*
PORT=8000

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MATCH_THRESHOLD=0.30
SUPABASE_MATCH_COUNT=6

# --- LLM providers ---
GEMINI_API_KEY=
CHAT_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_VISION_FALLBACK_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-flash

# --- RAG / embeddings ---
USE_ONNX=true
USE_RERANKER=true
EMBEDDING_CPU_THREADS=1
RAG_FINAL_COUNT=5
MAX_CHAT_TOKENS=1800

# --- Prescription documents ---
PRESCRIPTION_ORGANIZATION=
PRESCRIPTION_SERVICE_NAME=
PRESCRIPTION_DEFAULT_RESPONSIBLE=
PRESCRIPTION_DEFAULT_DEADLINE_DAYS=10
